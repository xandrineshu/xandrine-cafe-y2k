<!DOCTYPE html>
<html lang="en">

<%- include('partials/head') %>

<body>
    <%- include('partials/desktop') %>

    <div id="swup-container">
        <div class="about-window">
            <!-- Retro Window Top Bar -->
            <div class="title-bar">
                <span>♡ AboutMe.exe - Safari</span>
                <div class="window-buttons">
                    <span></span><span></span><span></span>
                </div>
            </div>
    
            <!-- Content Inside the Window -->
            <div class="window-content">
                <h1>about xandrine.</h1>
                <p class="tagline">developer 👩🏻‍💻 // digital creator 👾 // dreamer 💭</p>
    
                <hr class="retro-divider">
    
                <div class="about-grid">
                    <!-- Left: Profile Picture Box -->
                    <div class="about-avatar-box">
                        <!-- Replace src with the path to your image inside public/images/ -->
                        <img src="/images/pfp.png" alt="Profile Picture"
                            style="width: 100%; height: 160px; object-fit: cover; border: 1px solid #111; display: block;">
                        <p style="font-size: 0.8rem; margin: 8px 0 0 0; font-weight: bold;">@xandrine.café-y2k</p>
                    </div>
    
                    <!-- Right: Bio Information -->
                    <div class="about-text-box">
                        <p>
                            Welcome to my corner of the web!
                            I blend soft pastel aesthetics with backend
                            architecture, building cozy digital experiences. (๑'ᵕ'๑)⸝*</p>
    
                        <p><strong>🌸 fun facts & stack:</strong></p>
                        <ul class="bio-list">
                            <li><strong>aesthetics & vibe:</strong> Y2K, Acubi Chic & Cozy Café</li>
                            <li><strong>tech stack:</strong> Node.js, Express, EJS</li>
                            <li><strong>fuel:</strong> Coke Float & Pastel Themes</li>
                        </ul>
                    </div>
                </div>
    
                <%- include('partials/nav') %>
            </div>
        </div>
    </div>
    
    <!-- Retro Reset Desktop Button -->
    <button id="reset-desktop-btn" title="Reset all windows & treats to default">🔄 Reset Desktop</button>
    
    <%- include('partials/modal') %>
</body>

</html>