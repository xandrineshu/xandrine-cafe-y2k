<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Guestbook // Xandrine's Y2K Café</title>
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/guestbook.css">
    <script src="/js/sparkles.js"></script>
</head>

<body>

    <div class="retro-window guestbook-window">
        <!-- Retro Window Top Bar -->
        <div class="title-bar">
            <span>♡ Guestbook.exe - Safari</span>
            <div class="window-buttons">
                <span></span><span></span><span></span>
            </div>
        </div>

        <!-- Content Inside the Window -->
        <div class="window-content">
            <h1>guestbook.</h1>
            <p class="tagline">leave a little note before you leave the cafe!</p>

            <hr class="retro-divider">

            <div class="guestbook-grid">
                <!-- Left Column: Sign the Guestbook Form -->
                <div class="guestbook-form-col">
                    <h3 class="section-title">✍️ sign my guestbook</h3>
                    <form action="/guestbook" method="POST" class="retro-form">
                        <label class="form-label">your name / handle:</label>
                        <input type="text" name="name" required placeholder="@y2k_angel">

                        <label class="form-label">your message:</label>
                        <textarea name="message" rows="3" required placeholder="love the aesthetic! 💖"></textarea>

                        <button type="submit" class="retro-btn">post entry 💌</button>
                    </form>
                </div>

                <!-- Right Column: View Entries -->
                <div class="guestbook-entries-col">
                    <h3 class="section-title">💬 recent notes</h3>
                    <div class="guestbook-container">
                        <% if (locals.entries && entries.length> 0) { %>
                            <% entries.forEach(entry=> { %>
                                <div class="entry-card">
                                    <div class="entry-header">
                                        <strong>
                                            <%= entry.name %>
                                        </strong>
                                        <span>
                                            <%= entry.date %>
                                        </span>
                                    </div>
                                    <p class="entry-msg">
                                        <%= entry.message %>
                                    </p>
                                </div>
                                <% }) %>
                                    <% } else { %>
                                        <p class="no-entries">No entries yet. Be the first to sign!</p>
                                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Navigation Bar -->
            <div class="nav-links guestbook-nav">
                <a href="/">home</a>
                <a href="/about">about</a>
                <a href="/portfolio">portfolio</a>
                <a href="/guestbook">guestbook</a>
            </div>
        </div>
    </div>

</body>

</html>