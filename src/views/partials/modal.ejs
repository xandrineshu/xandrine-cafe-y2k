<!-- Retro Reset Confirmation Modal -->
<div id="reset-modal" class="retro-modal-overlay" style="display: none;">
    <div class="retro-modal-window">
        <div class="title-bar">
            <span>⚠️ System Warning.exe</span>
            <div class="window-buttons">
                <span></span><span></span><span></span>
            </div>
        </div>
        
        <div class="window-content" style="text-align: center; padding: 20px;">
            <p style="margin-top: 0; font-size: 0.95rem; font-weight: bold;">Reset all windows and clear spawned treats?
            </p>
            <div style="display: flex; justify-content: center; gap: 10px; margin-top: 20px;">
                <button id="modal-confirm-btn" class="retro-btn" style="background: #ff80ab;">Yes, reset</button>
                <button id="modal-cancel-btn" class="retro-btn" style="background: #fff;">Cancel</button>
            </div>
        </div>
    </div>
</div>