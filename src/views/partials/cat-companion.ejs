<div id="cat-companion-window" class="retro-window"
    style="display: none; width: 320px; min-width: 320px; box-sizing: border-box; position: fixed; top: 150px; left: 150px;">
    <div class="title-bar">
        <span>🐾 kuroo.exe - Companion</span>
        <div class="window-buttons">
            <span class="close-btn" data-target="cat-companion-window" style="cursor: pointer;" title="Close"></span>
            <span></span>
            <span></span>
        </div>
    </div>
    
    <div class="window-content" style="text-align: center; padding: 20px; box-sizing: border-box;">
        <p id="cat-status"
            style="font-size: 0.85rem; font-weight: bold; color: #333; margin-top: 0; word-wrap: break-word;">
            "Kuroo is napping... 💤"
        </p>
        <div style="display: flex; justify-content: center; gap: 8px; margin-top: 15px;">
            <button id="feed-cat-btn" class="retro-btn" style="font-size: 0.75rem;">Feed Treat 🐟</button>
            <button id="pet-cat-btn" class="retro-btn" style="font-size: 0.75rem;">Pet Kuroo ✨</button>
        </div>
