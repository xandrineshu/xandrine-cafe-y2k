const express = require('express');
const app = express();

// Set EJS as the templating engine
app.set('view engine', 'ejs');

// Serve static files (like CSS, images, client-side JS if needed)
app.use(express.static('public'));

// Routes
app.get('/', (req, res) => {
res.render('home');
});

app.get('/about', (req, res) => {
res.render('about');
});

app.get('/portfolio', (req, res) => {
res.render('portfolio');
});

app.get('/guestbook', (req, res) => {
res.render('guestbook');
});

const PORT = 3007;
app.listen(PORT, () => {
console.log(`✨ Xandrine's Y2k Cafe is about to open at http://localhost:3007 ☕💖`);
});